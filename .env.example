# Compose project name. Must be lowercase — Docker Compose rejects uppercase.
COMPOSE_PROJECT_NAME=landingpage

# --- Image ---
NGINX_IMAGE=nginxinc/nginx-unprivileged
NGINX_TAG=alpine

# --- Host port ---
# Direct LAN access without DNS or Traefik: http://fastpi.homelab:8095
HOST_PORT=8095

# This project has no secrets: the page is static and public, and it renders
# usernames only — never passwords. .env and .env.example are therefore
# identical, and .env is still gitignored so the pair stays consistent with
# every other project here.
