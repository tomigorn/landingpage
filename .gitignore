# Environment files (contain secrets) — keep .env.example tracked
.env
.env.*
!.env.example

# Keys & certificates
*.key
*.pem
*.crt
*.cert
*.csr
*.p12
*.pfx

# Credentials, secrets & tokens
secrets/
*.secret
*.token

# Logs
*.log

# Tooling state
.superpowers/

# AI working files (global rule, see ~/.claude/CLAUDE.md): never committed
docs/superpowers/
.claude/settings.local.json
CLAUDE.local.md
AGENTS.md
